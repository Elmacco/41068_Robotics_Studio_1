# ROS 2 generated folders. Matched anywhere, because colcon run from inside a
# package folder writes them there too. (Copies already committed under
# 41068_ignition_bringup/ and Ethan's folder stay tracked until those are
# cleaned up.)
build/
install/
log/
ros2_ws/symlink_install_manifest.txt

# Separate upstream repo (github.com/ros/ros_tutorials), not part of this repo's history
ros2_ws/src/ros_tutorials/

# Python generated files
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE and editor files
.vscode/
.idea/

# Temporary files
*.swp
*~
.DS_Store

# Large ROS bag recordings
*.db3
*.mcap

# Generated files inside the bringup model directory
ros2_ws/src/41068_ignition_bringup/models/build/
ros2_ws/src/41068_ignition_bringup/models/install/
ros2_ws/src/41068_ignition_bringup/models/log/
