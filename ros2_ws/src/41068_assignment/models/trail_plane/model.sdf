<sdf version="1.7">
<model name="trail_plane">
    <static>true</static>
    <link name="link">
        <!-- Flat for now, matching the visual. The hills heightmap below
             only ever loaded as collision (the visual stays a flat plane),
             so the drone hit hills nobody could see, up to 1.5 m high at
             the old launch pad. Swap it back in once the visual is a
             heightmap too.
        <collision name="collision">
            <geometry>
            <heightmap>
                    <uri>model://trail_plane/materials/textures/rolling_hills_heightmap_8bit.png</uri>
                    <pos>0 0 0</pos>
                    <size>50 50 5</size>
                </heightmap>
            </geometry>
        </collision>
        -->
        <collision name="collision">
            <geometry>
                <plane>
                    <normal>0 0 1</normal>
                    <size>50 50</size>
                </plane>
            </geometry>
        </collision>
        <visual name="visual">
            <pose>0 0 0.01 0 0 0</pose>
            <geometry>
                <plane>
                    <normal>0 0 1</normal>
                    <size>50 50</size>
                </plane>
            </geometry>
            <material>
                <ambient>0.45 0.22 0.08 1</ambient>
                <diffuse>0.45 0.22 0.08 1</diffuse>
                <pbr>
                    <metal>
                        <albedo_map>model://trail_plane/materials/textures/empty_grass.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
    </link>
</model>
</sdf>