<?xml version="1.0"?>
<!--
  Parrot drone + a thermal camera, built on top of the stock Parrot defined
  in 41068_ignition_bringup (urdf_parrot/parrot.urdf.xacro).

  We deliberately don't edit that file: it's the shared, course-provided
  package used by the whole team, so changes there affect every launch
  file that uses it and get clobbered if the unit pushes an update. Instead
  we xacro:include our own copy of it (parrot_base.urdf.xacro, which only
  adds tunable camera FOV/tilt) and add the extra sensor on top.
  This works because xacro:include only splices in the *children* of the
  included file's root element, not the root <robot> tag itself - bringup's
  own parrot.urdf.xacro already relies on this same trick to pull in
  common_properties.urdf.xacro and parrot.gazebo.xacro.
-->
<robot name="parrot_thermal" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Same args the stock Parrot xacro expects, forwarded straight through
       so spawn_parrot.launch.py can pass prefix/gz_model_name exactly as
       it would for the plain parrot.urdf.xacro. -->
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:arg name="gz_model_name" default="parrot"/>
  <xacro:property name="gz_model_name" value="$(arg gz_model_name)"/>

  <!-- Camera tuning, shared by the RGB-D and thermal cameras so both keep
       looking at the same patch of ground.

       camera_hfov: horizontal FOV in radians, default 140 deg (stock RGB-D
       is 120 deg). At the default 45 deg tilt both cameras already see from
       directly below the drone out to the horizon, so a wider FOV only buys
       sideways coverage - and costs pixels per degree. Pinhole cameras
       distort badly much past ~150 deg.

       camera_pitch: downward tilt in radians, default 45 deg (stock). -->
  <xacro:arg name="camera_hfov" default="2.44346"/>
  <xacro:property name="camera_hfov" value="$(arg camera_hfov)"/>
  <xacro:arg name="camera_pitch" default="0.785398"/>
  <xacro:property name="camera_pitch" value="$(arg camera_pitch)"/>

  <!-- Thermal image resolution. 640x480 (up from 320x240) so a person
       ~10 m away is ~13 px wide at 140 deg FOV instead of ~8 px at 120 deg -
       otherwise the thermal feed is the weak link for hiker detection.
       Real drone thermal cameras commonly come in 640x512. -->
  <xacro:arg name="thermal_width" default="640"/>
  <xacro:arg name="thermal_height" default="480"/>

  <!-- Our copy of bringup's parrot.urdf.xacro, with the RGB-D camera's FOV
       and tilt parameterised (see that file for why it's a copy). -->
  <xacro:include filename="$(find 41068_assignment)/urdf_parrot/parrot_base.urdf.xacro"/>

  <!-- Mount point for the thermal camera: same position/tilt as the RGB-D
       camera (front of the drone, angled camera_pitch down) so both cameras
       are roughly looking at the same thing. -->
  <joint name="${prefix}thermal_camera_joint" type="fixed">
    <origin xyz="0.25 0.0 0.20" rpy="0 ${camera_pitch} 0"/>
    <parent link="${prefix}base_link"/>
    <child link="${prefix}thermal_camera_link"/>
  </joint>

  <link name="${prefix}thermal_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.04"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <gazebo reference="${prefix}thermal_camera_link">
    <turnGravityOff>true</turnGravityOff>

    <!--
      type="thermal_camera" is rendered by the same world-level "Sensors"
      system plugin that already handles the RGB/RGBD cameras and lidar
      (loaded once, world-wide, by 41068_ignition_bringup's
      config/ignition_server.config). Nothing needs to change there -
      thermal_camera is just another sensor type that plugin knows about,
      backed by libignition-sensors6-thermal-camera.
    -->
    <sensor name="thermal_camera" type="thermal_camera">
      <camera>
        <!-- Same FOV as the RGB-D camera, so anything visible to one is
             visible to the other. -->
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>$(arg thermal_width)</width>
          <height>$(arg thermal_height)</height>
          <!-- thermal_camera requires a 16-bit format: each pixel is a
               temperature reading, and 8 bits isn't enough precision to
               distinguish meaningfully different temperatures. -->
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>40</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>3</update_rate>
      <topic>model/${gz_model_name}/thermal_camera</topic>
      <gz_frame_id>${prefix}thermal_camera_link</gz_frame_id>

      <!--
        This plugin configures *this sensor's* temperature range and
        precision - separate from the "Thermal" system plugin (see
        assignment_world.sdf), which instead tags individual objects in
        the world with a temperature for this sensor to pick up.

        Source: package libignition-gazebo6 (the core Gazebo Fortress
        runtime - the same package providing every other system plugin
        used elsewhere in this repo, e.g. Physics/Imu/VelocityControl).
        Installed automatically as a dependency of ros-humble-ros-gz-sim;
        nothing extra needed on top of the existing ROS 2 Humble + Gazebo
        Fortress setup.
      -->
      <plugin
        filename="ignition-gazebo-thermal-sensor-system"
        name="ignition::gazebo::systems::ThermalSensor">
        <!-- Sensing range in Kelvin: -20C to 400C. Wide enough to cover
             ambient temperature through a genuine heat source (body heat,
             fire, engine) without wasting the 16-bit range on
             temperatures nothing in the world will ever reach. -->
        <min_temp>253.15</min_temp>
        <max_temp>673.15</max_temp>
        <!-- Kelvin represented per step of sensor noise/quantisation. -->
        <resolution>3.0</resolution>
      </plugin>
    </sensor>
  </gazebo>

</robot>
