    <!-- Launch pad for the parrot on simple_trees -->
    <include>
      <uri>model://launch_pad</uri>
      <name>launch_pad</name>
      <pose>-4.0 -23.0 0.02 0 0 0</pose>
    </include>

    <!-- Trail 1, dude 1 -->
    <include>
      <uri>
        model://standing_person_hot
      </uri>
      <name>standing_person</name>
      <pose>-15.0 15.0 0 0 0 0</pose>
    </include>

   <!-- Trail 1, dude 2 -->
    <include>
