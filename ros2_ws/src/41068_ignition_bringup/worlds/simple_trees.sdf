<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="simple_trees">
    <!-- Basic world setup  -->
    <light name="sun" type="directional">
     <cast_shadows>0</cast_shadows>
      <pose>0 0 50 0 -0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Explicit thermal baseline for objects without assigned heat. -->
    <atmosphere type="adiabatic">
      <temperature>300.0</temperature>
      <temperature_gradient>0.1</temperature_gradient>
    </atmosphere>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5</ambient>
      <background>0.8 0.8 0.8</background>
      <shadows>1</shadows>
    </scene>

    <!-- Initialise spherical coordinates somewhere -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

  <include>
      <uri>
        model://trail_plane
      </uri>
      <name>trail_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak1</name>
      <pose>-0.3 3.5 0 0 0 0</pose>
    </include>

    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak2</name>
      <pose>-4.8 2.6 0 0 0 0</pose>
    </include>

    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak3</name>
      <pose>5.0 -4.0 0 0 0 0</pose>
    </include>

    <!-- Oak tree -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree
      </uri>
      <name>oak4</name>
      <pose>-6.0 -5.4 0 0 0 0</pose>
    </include>

    <!-- rock -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling%20Rock%201
      </uri>
      <name>rock</name>
      <scale>10 10 10</scale>
      <pose>3.3 2.3 0 0 0 0</pose>
    </include>

    <!-- Some dude -->
    <include>
      <uri>
        model://standing_person_hot
      </uri>
      <name>standing_person</name>
      <pose>4.0 3.0 0 0 0 0</pose>
    </include>

    <!-- Platypus -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/platypus
      </uri>
      <name>platypus</name>
      <pose>0.0 -3.0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
